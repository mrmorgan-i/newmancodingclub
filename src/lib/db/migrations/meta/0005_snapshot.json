          "value": "\"content_event\".\"kind\" = 'single' OR (\"content_event\".\"startDate\" IS NOT NULL AND \"content_event\".\"endDate\" IS NOT NULL AND \"content_event\".\"dayOfWeek\" BETWEEN 0 AND 6 AND \"content_event\".\"endDate\" >= \"content_event\".\"startDate\")"
